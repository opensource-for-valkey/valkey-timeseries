{
  "schema_version": 1,
  "name": "agg",
  "description": "Aggregation profile (docs/plans/aggregation-performance-plan.md): the core fixture; scan-only probe, raw full range and GET as controls, count/min/sum/avg at 100 buckets, avg at 1,000, GROUPBY at 10 and 100 groups. Plan defaults: 5 paired trials, 5 s warm-up, 30 s read trials.",
  "fixture": {
    "series": 1000,
    "samples_per_series": 1000,
    "workload": "drift",
    "timestamp_model": "regular",
    "label_cardinality": [
      1,
      10,
      100
    ],
    "label_value_len": 8,
    "key_prefix": "bench",
    "interval_ms": 1000
  },
  "series": {
    "chunk_size": 4096,
    "duplicate_policy": "BLOCK",
    "encoding": {
      "subject": "chimp",
      "reference": "compressed"
    }
  },
  "protocol": "resp2",
  "trials": 5,
  "warmup_seconds": 5,
  "read_duration_seconds": 30,
  "read_cycle_requests": 100000,
  "min_write_seconds": 30,
  "settle_seconds": 3,
  "cases": [
    {
      "id": "get_uniform_c8",
      "kind": "get",
      "distribution": {
        "type": "uniform"
      },
      "connections": 8
    },
    {
      "id": "range_full_nomatch_c8",
      "kind": "range",
      "window": {
        "type": "full"
      },
      "filter_by_value": {
        "min": 1e+300,
        "max": 1e+301
      },
      "connections": 8
    },
    {
      "id": "range_full_c8",
      "kind": "range",
      "window": {
        "type": "full"
      },
      "connections": 8
    },
    {
      "id": "agg_count100_c8",
      "kind": "aggregate",
      "window": {
        "type": "full"
      },
      "aggregator": "count",
      "buckets": 100,
      "connections": 8
    },
    {
      "id": "agg_min100_c8",
      "kind": "aggregate",
      "window": {
        "type": "full"
      },
      "aggregator": "min",
      "buckets": 100,
      "connections": 8
    },
    {
      "id": "agg_sum100_c8",
      "kind": "aggregate",
      "window": {
        "type": "full"
      },
      "aggregator": "sum",
      "buckets": 100,
      "connections": 8
    },
    {
      "id": "agg_avg100_c8",
      "kind": "aggregate",
      "window": {
        "type": "full"
      },
      "aggregator": "avg",
      "buckets": 100,
      "connections": 8
    },
    {
      "id": "agg_avg1000_c8",
      "kind": "aggregate",
      "window": {
        "type": "full"
      },
      "aggregator": "avg",
      "buckets": 1000,
      "connections": 8
    },
    {
      "id": "groupby_10groups_c8",
      "kind": "groupby",
      "label": 0,
      "group_label": 1,
      "window": {
        "type": "full"
      },
      "aggregator": "avg",
      "buckets": 100,
      "reducer": "sum",
      "connections": 8
    },
    {
      "id": "groupby_100groups_c8",
      "kind": "groupby",
      "label": 0,
      "group_label": 2,
      "window": {
        "type": "full"
      },
      "aggregator": "avg",
      "buckets": 100,
      "reducer": "sum",
      "connections": 8
    }
  ]
}
