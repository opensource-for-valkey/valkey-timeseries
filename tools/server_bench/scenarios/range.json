      10,
      100
    ],
    "label_value_len": 8,
    "key_prefix": "bench",
    "interval_ms": 1000
  },
  "series": {
    "chunk_size": 4096,
    "duplicate_policy": "BLOCK",
    "encoding": {
      "subject": "chimp",
      "reference": "compressed"
    }
  },
  "protocol": "resp2",
  "trials": 5,
  "warmup_seconds": 5,
  "read_duration_seconds": 30,
  "read_cycle_requests": 100000,
  "min_write_seconds": 30,
  "settle_seconds": 3,
  "cases": [
