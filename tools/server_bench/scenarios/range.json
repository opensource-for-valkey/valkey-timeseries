      "kind": "get",
      "distribution": {
        "type": "uniform"
      },
      "connections": 8
    },
    {
      "id": "range_recent100_c8",
      "kind": "range",
      "window": {
        "type": "recent",
        "points": 100
      },
      "connections": 8
    },
    {
      "id": "range_head100_c8",
      "kind": "range",
      "window": {
        "type": "head",
        "points": 100
      },
      "connections": 8
    },
    {
      "id": "range_middle10_c8",
      "kind": "range",
      "window": {
        "type": "middle",
        "percent": 10
      },
      "connections": 8
    },
    {
      "id": "range_full_c8",
      "kind": "range",
      "window": {
        "type": "full"
      },
      "connections": 8
    },
    {
